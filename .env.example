# Configure actual credentials in the deployment host's secret manager.
# For local development only, copy to ignored .env.local and enter the value there.
MODEL_API_KEY=
# Only the validated Spark adapter is active; other catalog models require their own bindings.
META_MODEL=muse-spark-1.3
# Leave empty for direct public entry. Optionally set a private workspace code
# on the persistent backend only; browser ownership remains required either way.
APP_ACCESS_CODE=
# Persistent writable directory shared by the web process and worker.
DATA_ROOT=./data
MAX_CLIP_BYTES=52428800
JOB_TIMEOUT_MS=120000
PORT=3000
# Hybrid hosting: set only on the Vercel frontend, never on the backend.
# HTTPS origin of the separate persistent backend; changing it requires a rebuild.
COUNTERSHOT_BACKEND_ORIGIN=
# Hybrid backend: exact HTTPS origin of the public Vercel site (no path).
APP_PUBLIC_ORIGIN=
# Hybrid backend: its own HTTPS origin for short-lived direct media uploads.
PUBLIC_API_ORIGIN=
